SOURCE_MODE=mock
# For SOURCE_MODE=linkedin use 900000 (15 min) or more.
POLL_INTERVAL_MS=180000
WORKER_INTERVAL_MS=1000
COLLECTOR_PORT=3101
PROCESSOR_PORT=3102
NOTIFIER_PORT=3103
TELEGRAM_MODE=dry-run
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PREFER_RUSSIAN=true
