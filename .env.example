DATABASE_URL=postgres://alerts:alerts@localhost:55432/alerts
SOURCE_MODE=mock
# LinkedIn search is protected by a minimum interval of 30 minutes.
POLL_INTERVAL_MS=180000
# Feed refresh cadence, separate from the search schedule.
FEED_POLL_INTERVAL_MS=300000
# Pause network collection while keeping /status and workers running.
COLLECTION_PAUSED=false
WORKER_INTERVAL_MS=1000
COLLECTOR_PORT=3101
PROCESSOR_PORT=3102
NOTIFIER_PORT=3103
TELEGRAM_MODE=dry-run
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PREFER_RUSSIAN=true
LINKEDIN_CONFIG_FILE=.local/linkedin.json
# Completed jobs older than this are purged (minimum 14).
RETENTION_DAYS=30
